-- cli_filter.lua generated by Slurm Single-Node.
-- Client-side UX filter; job_submit.lua and Slurm QOS/TRES remain authoritative.

local function value_blocks_requeue(value)
  if value == nil then
    return false
  end
  local text = string.lower(tostring(value))
  return text == "0" or text == "false" or text == "no" or text == "off"
end

local function argv_blocks_requeue(options)
  local argv = options.argv
  if argv == nil then
    return false
  end
  for _, arg in pairs(argv) do
    local text = tostring(arg)
    if text == "--no-requeue" then
      return true
    end
    if text == "--requeue=0" or text == "--requeue=no" or text == "--requeue=false" or text == "--requeue=off" then
      return true
    end
  end
  return false
end

local function reject_no_requeue()
  slurm.log_error("Slurm single-node: --no-requeue is not allowed for normal preemptible tiers.")
  return slurm.ERROR
end

function slurm_cli_setup_defaults(options, early_pass)
  return slurm.SUCCESS
end

function slurm_cli_pre_submit(options, pack_offset)
  if value_blocks_requeue(options["requeue"]) or argv_blocks_requeue(options) then
    return reject_no_requeue()
  end
  return slurm.SUCCESS
end

function slurm_cli_post_submit(offset, job_id, step_id)
  return slurm.SUCCESS
end
