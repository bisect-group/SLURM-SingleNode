# /etc/slurm/slurmdbd.conf
# Generated by Slurm Single-Node. Do not edit manually.

AuthType=auth/munge
DbdAddr=127.0.0.1
DbdHost={{ ssn.derived.db_host }}
DbdPort={{ ssn.derived.slurmdbd_port }}

SlurmUser=slurm
DebugLevel=info
LogFile={{ ssn.derived.slurm_log_dir }}/slurmdbd.log
PidFile={{ ssn.derived.slurm_pid_dir }}/slurmdbd.pid

StorageType=accounting_storage/mysql
StorageHost={{ ssn.derived.db_host }}
StoragePort=3306
StorageUser={{ ssn.derived.db_user }}
StoragePass={{ ssn_slurmdbd_db_password }}
StorageLoc={{ ssn.derived.db_name }}

ArchiveJobs=no
ArchiveSteps=no
ArchiveSuspend=no
PurgeEventAfter=24months
PurgeJobAfter=24months
PurgeStepAfter=24months
PurgeSuspendAfter=24months
