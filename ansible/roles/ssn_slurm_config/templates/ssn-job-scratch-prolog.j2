#!/usr/bin/env bash
# Managed by Slurm Single-Node.
set -euo pipefail

root="{{ ssn.resolved_policies.storage.job_scratch.root }}"
marker="/run/slurm-single-node/scratch-unhealthy"
job_id="${SLURM_JOB_ID:-}"
job_user="${SLURM_JOB_USER:-}"
job_uid="${SLURM_JOB_UID:-}"

mark_unhealthy() {
    rc="$?"
    if [ "$rc" -ne 0 ]; then
        mkdir -p /run/slurm-single-node
        {
            printf 'scratch prolog failed at %s\n' "$(date -Is)"
            printf 'job_id=%s user=%s uid=%s root=%s rc=%s\n' "$job_id" "$job_user" "$job_uid" "$root" "$rc"
        } > "$marker"
        chmod 0644 "$marker"
    fi
    exit "$rc"
}
trap mark_unhealthy EXIT

case "$root" in
    /scratch/jobs) ;;
    *) echo "SSN refusing unsafe job scratch root: $root" >&2; exit 1 ;;
esac

case "$job_id" in
    ''|*[!0-9_]* ) echo "SSN refusing unsafe job id for scratch: $job_id" >&2; exit 1 ;;
esac

if [ -z "$job_user" ] && [ -z "$job_uid" ]; then
    echo "SSN cannot identify job owner for scratch" >&2
    exit 1
fi

if [ -e "$marker" ]; then
    echo "SSN scratch is marked unhealthy; run ssn-scratch-health after repair." >&2
    exit 1
fi

mkdir -p "$root"
chmod 1777 "$root"

job_dir="$root/$job_id"
mkdir -p "$job_dir"
chmod 0700 "$job_dir"
if [ -n "$job_uid" ]; then
    chown "$job_uid" "$job_dir"
else
    chown "$job_user" "$job_dir"
fi

{% if ssn.derived.has_gpus | bool %}
gpu_mode_file="/etc/slurm-single-node/gpu-isolation-mode"
if [ -r "$gpu_mode_file" ] && [ "$(cat "$gpu_mode_file" 2>/dev/null)" = "acl" ]; then
    job_details="$(scontrol show job "$job_id" -o 2>/dev/null || true)"
    case "$job_details" in
        *gres/gpu*|*gpu:*)
            acl_root="/run/slurm-single-node/gpu-acl/$job_user"
            mkdir -p "$acl_root"
            chmod 0700 "$acl_root"
            touch "$acl_root/$job_id"
            for dev in /dev/nvidiactl /dev/nvidia-uvm /dev/nvidia-uvm-tools /dev/nvidia-modeset /dev/nvidia[0-9]* /dev/nvidia-caps/*; do
                [ -e "$dev" ] || continue
                [ -c "$dev" ] || continue
                setfacl -m "u:${job_user}:rw" "$dev" 2>/dev/null || true
            done
            ;;
    esac
fi
{% endif %}

trap - EXIT
exit 0
