# /etc/slurm/slurm.conf
# Generated by Slurm Single-Node. Do not edit manually.

ClusterName={{ ssn.identity.cluster_name }}
SlurmctldHost={{ ssn.identity.node_name }}

AuthType=auth/munge
SlurmUser=slurm
SlurmdUser=root

StateSaveLocation={{ ssn.derived.slurm_spool_dir }}/slurmctld
SlurmdSpoolDir={{ ssn.derived.slurm_spool_dir }}/slurmd
SlurmctldPidFile={{ ssn.derived.slurm_pid_dir }}/slurmctld.pid
SlurmdPidFile={{ ssn.derived.slurm_pid_dir }}/slurmd.pid

SlurmctldLogFile={{ ssn.derived.slurm_log_dir }}/slurmctld.log
SlurmdLogFile={{ ssn.derived.slurm_log_dir }}/slurmd.log
SlurmctldDebug=info
SlurmdDebug=info

SlurmctldPort=6817
SlurmdPort=6818

ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup,task/affinity

JobSubmitPlugins=lua
{% set ssn_cli_filter = ssn.resolved_policies.slurm_core.submit_filter.client_filter | default({}) %}
{% if ssn_cli_filter.enabled | default(false) | bool %}
CliFilterPlugins={{ ssn_cli_filter.plugin | default('cli_filter/lua') }}
CliFilterParameters=cli_filter_lua_path={{ ssn_cli_filter.path | default(ssn.derived.slurm_conf_dir ~ '/cli_filter.lua') }}
{% endif %}
{% if ssn.resolved_policies.storage.job_scratch.implementation | default('disabled') == 'prolog_epilog' %}
Prolog=/etc/slurm/prolog.d/ssn-job-scratch
Epilog=/etc/slurm/epilog.d/ssn-job-scratch
{% endif %}
{% if ssn.resolved_policies.storage.job_scratch.implementation | default('disabled') == 'prolog_epilog' or ssn.resolved_policies.cache.injection.slurm_jobs | default(false) | bool %}
TaskProlog=/etc/slurm/task-prolog.d/ssn-job-env
{% endif %}
SchedulerType=sched/backfill
SelectType={{ ssn.resolved_policies.slurm_core.select.type }}
SelectTypeParameters={{ ssn.resolved_policies.slurm_core.select.parameters }}

AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ ssn.derived.db_host }}
AccountingStoragePort={{ ssn.derived.slurmdbd_port }}
AccountingStorageTRES={{ ssn.derived.accounting_storage_tres | join(',') }}
AccountingStorageEnforce=qos,limits,safe,associations
JobAcctGatherType=jobacct_gather/cgroup
JobAcctGatherFrequency=30

PriorityType=priority/multifactor
PriorityDecayHalfLife={{ ssn.derived.priority.decay_half_life }}
PriorityFavorSmall=NO
PriorityWeightFairshare={{ ssn.derived.priority.weight_fairshare }}
PriorityWeightAge={{ ssn.derived.priority.weight_age }}
PriorityWeightQOS={{ ssn.derived.priority.weight_qos }}
PriorityWeightJobSize=0
PriorityWeightPartition=0

PreemptType=preempt/qos
PreemptMode=REQUEUE
JobRequeue=1

DefMemPerCPU={{ ssn.derived.def_mem_per_cpu_mb }}
MaxMemPerCPU={{ ssn.derived.max_mem_per_cpu_mb }}

SlurmctldTimeout=120
SlurmdTimeout=300
InactiveLimit=0
MinJobAge=300
KillWait=30
Waittime=0
ReturnToService=2
MaxArraySize=1000

{% if ssn.derived.has_gpus %}
GresTypes=gpu
NodeName={{ ssn.identity.node_name }} CPUs={{ ssn.derived.cpus_allocatable }} RealMemory={{ ssn.derived.memory_allocatable_mb }} Gres=gpu{% if ssn.hardware.gpu_type %}:{{ ssn.hardware.gpu_type }}{% endif %}:{{ ssn.hardware.gpus }} State=UNKNOWN
{% else %}
NodeName={{ ssn.identity.node_name }} CPUs={{ ssn.derived.cpus_allocatable }} RealMemory={{ ssn.derived.memory_allocatable_mb }} State=UNKNOWN
{% endif %}

PartitionName={{ ssn.identity.default_partition }} Nodes={{ ssn.identity.node_name }} Default=YES MaxTime={{ ssn.derived.max_walltime }} DefaultTime={{ ssn.derived.default_walltime }} State=UP OverSubscribe=NO TRESBillingWeights=CPU=1.0{% if ssn.derived.has_gpus %},GRES/gpu=64.0{% endif %}
