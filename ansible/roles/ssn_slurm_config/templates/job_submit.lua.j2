-- job_submit.lua generated by Slurm Single-Node.
-- This is a fast submit-time UX gate; Slurm QOS/TRES/cgroups remain authoritative.

local tier_limits = {
{% for tier in ssn.derived.rendered_tiers %}
  ["{{ tier.qos }}"] = {
    name = "{{ tier.name }}",
    max_cpus = {{ tier.max_cpus_per_job }},
    max_gpus = {% if tier.max_gpus_per_job is none %}nil{% else %}{{ tier.max_gpus_per_job }}{% endif %}
  },
{% endfor %}
}

local function requested_gpus(job_desc)
  local count = 0
  local fields = {job_desc.tres_per_job, job_desc.tres_per_node, job_desc.gres}
  for _, field in ipairs(fields) do
    if field ~= nil then
      for value in string.gmatch(field, "gpu[:=](%d+)") do
        count = count + tonumber(value)
      end
      for value in string.gmatch(field, "gres/gpu=(%d+)") do
        count = count + tonumber(value)
      end
    end
  end
  return count
end

local function requested_cpus(job_desc)
  local tasks = job_desc.num_tasks or 1
  local cpus_per_task = job_desc.cpus_per_task or 1
  local min_cpus = job_desc.min_cpus or 0
  if tasks < 1 or tasks >= 65534 then
    tasks = 1
  end
  if cpus_per_task < 1 or cpus_per_task >= 65534 then
    cpus_per_task = 1
  end
  if min_cpus < 0 or min_cpus >= 65534 then
    min_cpus = 0
  end
  local requested = tasks * cpus_per_task
  if min_cpus > requested then
    requested = min_cpus
  end
  return requested
end

local function reject(message)
  slurm.log_user(message)
  return slurm.ERROR
end

function slurm_job_submit(job_desc, part_list, submit_uid)
  local qos = job_desc.qos
  if qos == nil or qos == "" then
    return slurm.SUCCESS
  end

  local limit = tier_limits[qos]
  if limit == nil then
    return slurm.SUCCESS
  end

  local cpus = requested_cpus(job_desc)
  if cpus > limit.max_cpus then
    return reject(string.format(
      "Slurm single-node: QOS '%s' allows at most %d CPU(s) per job; requested %d.",
      qos, limit.max_cpus, cpus
    ))
  end

  local gpus = requested_gpus(job_desc)
  if limit.max_gpus == nil and gpus > 0 then
    return reject("Slurm single-node: this CPU-only profile does not accept GPU requests.")
  end
  if limit.max_gpus ~= nil and gpus > limit.max_gpus then
    return reject(string.format(
      "Slurm single-node: QOS '%s' allows at most %d GPU(s) per job; requested %d.",
      qos, limit.max_gpus, gpus
    ))
  end

  if job_desc.requeue ~= nil and job_desc.requeue == 0 then
    return reject("Slurm single-node: --no-requeue is not allowed for normal preemptible tiers.")
  end

  return slurm.SUCCESS
end

function slurm_job_modify(job_desc, job_rec, part_list, modify_uid)
  if job_desc.requeue ~= nil and job_desc.requeue == 0 then
    return reject("Slurm single-node: --no-requeue is not allowed for normal preemptible tiers.")
  end
  return slurm.SUCCESS
end

slurm.log_info("Slurm single-node job_submit.lua loaded.")
return slurm.SUCCESS
